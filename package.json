{
  "name": "aim-session-sdk",
  "version": "0.1.0",
  "description": "Session-based JavaScript SDK and CLI for Google AI Mode, with answers and citations.",
  "license": "UNLICENSED",
  "type": "module",
  "types": "./src/sdk.d.ts",
  "files": ["bin/", "src/"],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/sdk.d.ts",
      "import": "./src/sdk.js"
    }
  },
  "scripts": {
    "start": "node bin/aim.js",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "bin": {
    "aim": "bin/aim.js"
  }
}
